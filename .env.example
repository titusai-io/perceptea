# Perceptea configuration.
#
# Copy to .env and edit. The file is read at startup from the working
# directory; a variable that is already set in the real environment always
# wins, and a missing file is not an error. Never commit a real key.

# ---------------------------------------------------------------- server ---

# Listen address. The -addr flag overrides it.
# PERCEPTEA_ADDR=:8080

# How long one request may take, end to end. Anything longer gets a 504.
# PERCEPTEA_REQUEST_TIMEOUT=60s

# Largest request body accepted, in bytes (2 MiB). Anything bigger gets a 413.
# PERCEPTEA_MAX_BODY_BYTES=2097152

# How many scoring calls one evaluation may have in flight at once. Each
# declared candidate answer is one call, so a request with many options can
# fan out widely.
# PERCEPTEA_MAX_CONCURRENCY=8

# Whether a request body may carry its own "api_key" and "base_url".
# Leave this on for local development. Turn it OFF anywhere reachable by
# anyone else: with it on, the service is an open proxy to any OpenAI
# compatible endpoint the caller names, paid for by whoever holds the key.
# PERCEPTEA_ALLOW_REQUEST_CREDENTIALS=true

# Comma-separated URL prefixes a request body's "base_url" must start with.
# Empty, the default, means any endpoint the caller names. This is the middle
# setting between the open proxy above and switching request credentials off
# altogether: callers may still bring their own key, but only for endpoints
# you listed. It never applies to PERCEPTEA_BASE_URL below, which is yours.
# End each prefix at a host or a path separator: a prefix is matched as text,
# so https://api.example would also match https://api.example.attacker.test.
# PERCEPTEA_ALLOWED_BASE_URLS=https://api.openai.com/v1,http://127.0.0.1:11434/v1

# debug, info, warn or error.
# PERCEPTEA_LOG_LEVEL=info

# text or json.
# PERCEPTEA_LOG_FORMAT=text

# -------------------------------------------------------------- provider ---

# Which preset to use: openai, openrouter, deepinfra or zai. The preset fixes
# the base URL, the default model and which key variable is read.
# PERCEPTEA_PROVIDER=openai

# Override the preset's base URL, for a proxy, a gateway or a local server
# that speaks the OpenAI chat completions API. It must be an absolute http or
# https URL; anything else stops the process at startup rather than failing
# every request. A credential in it — userinfo, or a ?key= — is kept out of
# responses and log lines, which show the endpoint without it.
# PERCEPTEA_BASE_URL=http://localhost:11434/v1

# Override the preset's default model. The deepinfra preset's model id is a
# best-effort guess at that provider's naming, so set this if it 404s.
# PERCEPTEA_MODEL=gpt-4o-mini

# Sampling temperature for the scoring calls. 0 is the only value that makes
# a classification reproducible.
# PERCEPTEA_TEMPERATURE=0

# ------------------------------------------------------------------ keys ---

# The key used regardless of provider. Checked first.
# PERCEPTEA_API_KEY=

# Otherwise the active preset's own variable is read. Only the active
# provider's variable is consulted.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPINFRA_API_KEY=
# ZAI_API_KEY=
