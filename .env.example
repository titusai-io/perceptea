# Perceptea configuration.
#
# Copy to .env and edit. The file is read at startup from the working
# directory; a variable that is already set in the real environment always
# wins, and a missing file is not an error. Never commit a real key.

# ---------------------------------------------------------------- server ---

# Listen address. The -addr flag overrides it.
# PERCEPTEA_ADDR=:8080

# How long one request may take, end to end. Anything longer gets a 504.
# PERCEPTEA_REQUEST_TIMEOUT=60s

# Largest request body accepted, in bytes (2 MiB). Anything bigger gets a 413.
# PERCEPTEA_MAX_BODY_BYTES=2097152

# How many scoring calls one evaluation may have in flight at once. Each
# declared candidate answer is one call, so a request with many options can
# fan out widely.
# PERCEPTEA_MAX_CONCURRENCY=8

# Whether a request body may carry its own "api_key" and "inference_base_url".
# Leave this on for local development. Turn it OFF anywhere reachable by
# anyone else: with it on, the service is an open proxy to any chat
# completions endpoint the caller names, paid for by whoever holds the key.
# There is no middle setting; put the service behind something that
# authenticates if it needs one.
# PERCEPTEA_ALLOW_REQUEST_CREDENTIALS=true

# debug, info, warn or error.
# PERCEPTEA_LOG_LEVEL=info

# text or json.
# PERCEPTEA_LOG_FORMAT=text

# ------------------------------------------------------------- inference ---

# The API root of the service that actually runs the model: a hosted endpoint,
# a gateway, or a local model server. The client appends /chat/completions to
# it and calls it once per declared candidate answer.
#
# It must be an absolute http or https URL; anything else stops the process at
# startup rather than failing every request. A credential in it — userinfo, or
# a ?key= — is kept out of responses and log lines, which show the endpoint
# without it.
#
# Endpoints you can point it at, with an id each publishes for the same
# model:
#   https://api.deepinfra.com/v1/openai   zai-org/GLM-5.3-Flash
#   https://openrouter.ai/api/v1          z-ai/glm-5.3-flash
#   https://api.z.ai/api/paas/v4          glm-5.3-flash
#   http://localhost:11434/v1             (Ollama: whatever you have pulled)
#   http://localhost:8000/v1              (vLLM: the id it was started with)
# PERCEPTEA_INFERENCE_BASE_URL=https://api.deepinfra.com/v1/openai

# The model id to score with. It has to be one the endpoint above serves.
# PERCEPTEA_MODEL=zai-org/GLM-5.3-Flash

# Sampling temperature for the scoring calls. 0 is the only value that makes
# a classification reproducible.
# PERCEPTEA_TEMPERATURE=0

# ------------------------------------------------------------------ keys ---

# The key sent to the endpoint above as a bearer token. This is the only
# variable a key is read from, whichever endpoint you point at. A local model
# server usually wants a throwaway string here rather than nothing at all.
# PERCEPTEA_API_KEY=
