# Perceptea configuration.
#
# Copy to .env and edit. The file is read at startup from the working
# directory; a variable that is already set in the real environment always
# wins, and a missing file is not an error. Never commit a real key.

# ---------------------------------------------------------------- server ---

# Listen address. The -addr flag overrides it.
# PERCEPTEA_ADDR=:5301

# How long one request may take, end to end. Anything longer gets a 504.
# PERCEPTEA_REQUEST_TIMEOUT=60s

# Largest request body accepted, in bytes (2 MiB). Anything bigger gets a 413.
# PERCEPTEA_MAX_BODY_BYTES=2097152

# How many scoring calls one request may have in flight at once. Each
# declared candidate answer is one call, so a request with many options can
# fan out widely. On /api/evaluate/batch this is the budget for the whole
# job, shared by every item, rather than one budget per item.
# PERCEPTEA_MAX_CONCURRENCY=8

# The most states one /api/evaluate/batch request may carry. A batch fans out
# into items x candidates calls, so this is what stops a single request
# committing to an unbounded amount of provider spend. Over it gets a 400.
# PERCEPTEA_MAX_BATCH_ITEMS=100

# Whether a request body may carry its own "api_key" and "inference_base_url".
# Leave this on for local development. Turn it OFF anywhere reachable by
# anyone else: with it on, the service is an open proxy to any chat
# completions endpoint the caller names, paid for by whoever holds the key.
# There is no middle setting; put the service behind something that
# authenticates if it needs one.
# PERCEPTEA_ALLOW_REQUEST_CREDENTIALS=true

# debug, info, warn or error.
# PERCEPTEA_LOG_LEVEL=info

# text or json.
# PERCEPTEA_LOG_FORMAT=text

# ------------------------------------------------------------- inference ---

# The API root of the service that actually runs the model: a hosted endpoint,
# a gateway, or a local model server. The client appends /chat/completions to
# it and calls it once per declared candidate answer.
#
# It must be an absolute http or https URL; anything else stops the process at
# startup rather than failing every request. A credential in it — userinfo, or
# a ?key= — is kept out of responses and log lines, which show the endpoint
# without it.
#
# Endpoints you can point it at, with a model id each of them publishes:
#   https://api.deepinfra.com/v1/openai   mistralai/Mistral-Small-24B-Instruct-2501
#   https://openrouter.ai/api/v1          meta-llama/llama-3.1-8b-instruct
#   https://api.z.ai/api/paas/v4          glm-5.3-flash
#   http://localhost:11434/v1             (Ollama: whatever you have pulled)
#   http://localhost:8000/v1              (vLLM: the id it was started with)
# PERCEPTEA_INFERENCE_BASE_URL=https://api.deepinfra.com/v1/openai

# The model id to score with. It has to be one the endpoint above serves.
#
# Pick a model that does NOT reason. A scoring reply is capped at 32 tokens,
# which is room for {"p":0.87} and nothing else; a model that thinks first
# spends the whole budget on thinking tokens and the reply is cut off before
# the JSON. That is now a loud 502 rather than a silent 0.5 for every
# candidate, but it is still a request that fails. See "Choosing a model" in
# the README.
# PERCEPTEA_MODEL=mistralai/Mistral-Small-24B-Instruct-2501

# Sent to the provider as reasoning_effort on every call: none, low, medium
# or high. Unset — the default — sends no reasoning field at all, which is
# what an endpoint that has never seen one expects.
#
# Set it to "none" when you have to use a model whose thinking can be turned
# off; a model tagged as reasoning with no way to disable it will still be
# truncated whatever this says. Anything other than the four values stops the
# process at startup.
# PERCEPTEA_REASONING_EFFORT=

# Sampling temperature for the scoring calls: what the provider is told, so
# how the model draws its tokens. 0 is the only value that makes a
# classification reproducible. This is not the softmax temperature below.
# PERCEPTEA_TEMPERATURE=0

# Softmax temperature: how sharply one question's candidate scores are
# normalised into a distribution. Nothing is sent anywhere — it is the
# divisor applied to the logits before the softmax, and it is unrelated to
# the sampling temperature above.
#
# It cannot change an answer. Dividing every logit of a question by the same
# positive number is monotone, so the winner and the ranking are the same at
# every temperature; what moves is how confident the numbers beside them
# read. 1 is the identity and leaves every distribution exactly as it was.
#
# A fitted value calibrates better but is fitted to one model on one task —
# see "The softmax temperature" in the README for how to fit your own with
# cmd/perceptea-bench. Must be a finite positive number; 0, a negative or a
# word stops the process at startup.
# PERCEPTEA_SOFTMAX_TEMPERATURE=1

# How a probability is obtained. "chat" asks the model to write one;
# "logprob" reads it out of the first token's distribution, which is
# continuous where a written number clusters on round values. logprob needs an
# endpoint and a model that return logprobs, and it fails loudly when they do
# not — see "Two scorers" in the README.
# PERCEPTEA_SCORER=chat

# ------------------------------------------------------------------ keys ---

# The key sent to the endpoint above as a bearer token. This is the only
# variable a key is read from, whichever endpoint you point at. A local model
# server usually wants a throwaway string here rather than nothing at all.
# PERCEPTEA_API_KEY=
